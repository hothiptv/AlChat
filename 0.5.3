function createCodeBlockCard(lang, codeContent) {
    const card = document.createElement("div");
    card.className = "code-block-card";
    
    const cleanLang = (lang || "code").trim().toLowerCase();
    const isHtml = cleanLang === "html" || cleanLang === "htm" || 
                   codeContent.trim().toLowerCase().startsWith("<!doctype html") || 
                   codeContent.trim().toLowerCase().startsWith("<html");
                   
    const langDisplay = (cleanLang || "CODE").toUpperCase();
    const snippetLines = codeContent.trim().split('\n').slice(0, 3).join('\n');

    card.innerHTML = `
        <div class="code-card-header">
            <span class="fw-bold text-info small"><i class="bi bi-code-slash me-1"></i>${langDisplay}</span>
            <div class="d-flex gap-1">
                ${isHtml ? `<button class="btn btn-sm btn-success run-html-btn"><i class="bi bi-play-fill me-1"></i>Run App</button>` : ''}
                <button class="btn btn-sm btn-outline-light view-code-btn"><i class="bi bi-eye-fill me-1"></i>View</button>
                <button class="btn btn-sm btn-outline-light copy-code-btn"><i class="bi bi-clipboard me-1"></i>Copy</button>
            </div>
        </div>
        <pre class="p-2 m-0 small" style="background:transparent; color:var(--text-main); font-family:Consolas, monospace;"><code>${escapeHtml(snippetLines)}</code></pre>
    `;

    card.querySelector(".view-code-btn").addEventListener("click", (e) => {
        e.stopPropagation(); openCodeModal(langDisplay, codeContent);
    });
    card.querySelector(".copy-code-btn").addEventListener("click", (e) => {
        e.stopPropagation(); copyToClipboard(codeContent, true);
    });
    if (isHtml) {
        card.querySelector(".run-html-btn").addEventListener("click", (e) => {
            e.stopPropagation(); openWebPreview(codeContent);
        });
    }
    return card;
}

function renderFormattedMessageContent(container, rawText, isAssistant, msgObj) {
    container.innerHTML = "";
    if (!rawText && (!msgObj || !msgObj.files || msgObj.files.length === 0)) return;

    if (msgObj && msgObj.files && msgObj.files.length > 0) {
        const pillsDiv = document.createElement("div");
        pillsDiv.className = "msg-attached-pills";
        msgObj.files.forEach(f => {
            const pill = document.createElement("span");
            pill.className = "msg-attached-pill";
            pill.innerHTML = `<i class="bi bi-file-earmark-code"></i> ${escapeHtml(f.name)}`;
            pillsDiv.appendChild(pill);
        });
        container.appendChild(pillsDiv);
    }

    const textToProcess = rawText || "";
    const codeBlockRegex = /```([a-zA-Z0-9_+-]*)\r?\n?([\s\S]*?)(?:```|$)/g;
    let lastIndex = 0;
    let match;

    while ((match = codeBlockRegex.exec(textToProcess)) !== null) {
        const proseBefore = textToProcess.slice(lastIndex, match.index);
        if (proseBefore.trim()) {
            const textSpan = document.createElement("div");
            textSpan.className = "msg-text-block";
            textSpan.innerHTML = parseFullMarkdown(proseBefore);
            container.appendChild(textSpan);
        }

        const lang = match[1];
        const codeContent = match[2];
        if (match[0].startsWith("```")) {
            container.appendChild(createCodeBlockCard(lang, codeContent));
        }

        lastIndex = codeBlockRegex.lastIndex;
        if (match.index === codeBlockRegex.lastIndex) codeBlockRegex.lastIndex++;
    }

    const proseAfter = textToProcess.slice(lastIndex);
    if (proseAfter.trim()) {
        const textSpan = document.createElement("div");
        textSpan.className = "msg-text-block";
        textSpan.innerHTML = parseFullMarkdown(proseAfter);
        container.appendChild(textSpan);
    }
}

async function initApp() {
    try {
        const docRef = doc(db, "modelasi_settings", "config");
        let docSnap = await getDoc(docRef);

        if (!docSnap.exists()) {
            const oldRef = doc(db, "alchat_settings", "config");
            docSnap = await getDoc(oldRef);
        }

        if (docSnap.exists()) {
            const data = docSnap.data();
            if (data.apiKeys && Array.isArray(data.apiKeys)) {
                groqApiKeys = data.apiKeys.filter(k => k && k.trim());
            } else if (data.apiKey) {
                groqApiKeys = [data.apiKey.trim()];
            }

            if (data.systemPrompt) adminSystemPrompt = data.systemPrompt.trim();
            if (data.globalModelTag) globalModelTag = data.globalModelTag.trim();
            
            if (data.models && Array.isArray(data.models)) {
                dbModelsList = data.models;
            }
        }

        if (dbModelsList.length > 0) {
            if (!selectedModelId || !dbModelsList.some(m => m.id === selectedModelId)) {
                selectedModelId = dbModelsList[0].id;
                localStorage.setItem("modelasi_selected_model_id", selectedModelId);
            }
        } else {
            selectedModelId = "";
        }

        updateHeaderModelDisplay();

        userInput.disabled = false;
        userInput.placeholder = "Type a message...";

        const fullPrompt = getFullSystemPrompt();
        if (!sessions[activeSessionId]) {
            sessions[activeSessionId] = [{ role: "system", content: fullPrompt }];
        } else {
            if (sessions[activeSessionId][0] && sessions[activeSessionId][0].role === "system") {
                sessions[activeSessionId][0].content = fullPrompt;
            } else {
                sessions[activeSessionId].unshift({ role: "system", content: fullPrompt });
            }
        }

        saveLocalSessions();
        renderSidebar();
        renderChat();

    } catch (err) {
        console.error("Init Error:", err);
        userInput.placeholder = "Type a message...";
        userInput.disabled = false;
        updateHeaderModelDisplay();
    }
}

function updateHeaderModelDisplay() {
    const activeModel = getActiveModelObj();
    headerModelName.innerText = activeModel.name;
}

function openModelSelectModal() {
    modelListModalContainer.innerHTML = "";
    if (dbModelsList.length === 0) {
        modelListModalContainer.innerHTML = `<div class="text-center text-secondary py-3">No AI models found in database. Please add models in Management Panel.</div>`;
    } else {
        dbModelsList.forEach(m => {
            const isSelected = (m.id === selectedModelId);
            const card = document.createElement("div");
            card.className = `model-card-item ${isSelected ? 'selected' : ''}`;

            card.innerHTML = `
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="fw-bold text-main" style="font-size: 15px;">
                            ${escapeHtml(m.name)}
                        </div>
                    </div>
                    ${isSelected ? `<span class="badge bg-info text-dark fw-bold"><i class="bi bi-check-circle-fill"></i> Selected</span>` : ''}
                </div>
            `;

            card.addEventListener("click", () => {
                selectedModelId = m.id;
                localStorage.setItem("modelasi_selected_model_id", selectedModelId);
                updateHeaderModelDisplay();
                
                if (sessions[activeSessionId] && sessions[activeSessionId][0]) {
                    sessions[activeSessionId][0].content = getFullSystemPrompt();
                }
                saveLocalSessions();

                selectModelModal.hide();
            });

            modelListModalContainer.appendChild(card);
        });
    }
    selectModelModal.show();
}

function saveLocalSessions() {
    try {
        localStorage.setItem("modelasi_sessions", JSON.stringify(sessions));
        localStorage.setItem("modelasi_active_session", activeSessionId);
        localStorage.setItem("modelasi_session_names", JSON.stringify(sessionNames));
    } catch (e) {}
}

function renderSidebar() {
    const sessionList = document.getElementById("sessionList");
    if (!sessionList) return;
    const sessionKeys = Object.keys(sessions);
    document.getElementById("sessionCount").innerText = sessionKeys.length;

    sessionList.innerHTML = "";
    sessionKeys.forEach((sId, index) => {
        const div = document.createElement("div");
        div.className = `session-item ${sId === activeSessionId ? 'active' : ''}`;
        
        const titleText = sessionNames[sId] || `Chat #${index + 1}`;
        div.innerText = titleText;

        let pressTimer = null;
        let isLongPress = false;

        const startPress = () => {
            isLongPress = false;
            pressTimer = setTimeout(() => {
                isLongPress = true;
                showSessionOptions(sId, titleText);
            }, 600);
        };

        const cancelPress = () => { if (pressTimer) clearTimeout(pressTimer); };

        div.addEventListener("touchstart", startPress, {passive: true});
        div.addEventListener("touchend", cancelPress);
        div.addEventListener("mousedown", startPress);
        div.addEventListener("mouseup", cancelPress);
        div.addEventListener("mouseleave", cancelPress);

        div.addEventListener("click", () => {
            if (!isLongPress) switchSession(sId);
        });

        sessionList.appendChild(div);
    });
}

function showSessionOptions(sId, currentTitle) {
    const action = confirm(`What action would you like to perform for "${currentTitle}"?\n\n- OK to RENAME\n- CANCEL to DELETE`);
    if (action) {
        const newTitle = prompt("Enter new title for chat:", currentTitle);
        if (newTitle && newTitle.trim()) {
            sessionNames[sId] = newTitle.trim();
            saveLocalSessions();
            renderSidebar();
        }
    } else {
        if (confirm(`Are you sure you want to DELETE "${currentTitle}"?`)) {
            delete sessions[sId];
            delete sessionNames[sId];
            const remainingKeys = Object.keys(sessions);
            if (remainingKeys.length === 0) {
                const newId = "session_" + Date.now();
                sessions[newId] = [{ role: "system", content: getFullSystemPrompt() }];
                activeSessionId = newId;
            } else if (sId === activeSessionId) {
                activeSessionId = remainingKeys[0];
            }
            saveLocalSessions();
            renderSidebar();
            renderChat();
        }
    }
}

function attachMessageGestureListeners(div, msgObj, msgIndex) {
    let tapCount = 0;
    let tapTimer = null;
    let longPressTimer = null;
    let isLongPressExecuted = false;

    // Triple Tap / Rapid Click Handler
    const handleTripleTap = () => {
        copyToClipboard(msgObj.content || "", true);
    };

    // Long Press Handler (Hold to Regenerate / Edit message)
    const handleLongPress = () => {
        if (isGenerating) return;
        isLongPressExecuted = true;
        
        if (msgObj.role === "user") {
            // Fill input with user message and regenerate from this point
            userInput.value = msgObj.content || "";
            updateSendButtonState();
            userInput.focus();
            showToastNotification("Message loaded into input to resend");
        } else {
            // Re-generate AI response from the preceding prompt
            regenerateMessageFromIndex(msgIndex);
        }
    };

    const startPressTimer = (e) => {
        isLongPressExecuted = false;
        if (longPressTimer) clearTimeout(longPressTimer);
        longPressTimer = setTimeout(() => {
            handleLongPress();
        }, 500); // 500ms hold
    };

    const cancelPressTimer = () => {
        if (longPressTimer) clearTimeout(longPressTimer);
    };

    // Touch events
    div.addEventListener("touchstart", (e) => {
        startPressTimer(e);
    }, { passive: true });

    div.addEventListener("touchend", (e) => {
        cancelPressTimer();
        if (isLongPressExecuted) return;

        tapCount++;
        if (tapCount === 1) {
            tapTimer = setTimeout(() => {
                tapCount = 0;
            }, 400);
        } else if (tapCount === 3) {
            clearTimeout(tapTimer);
            tapCount = 0;
            handleTripleTap();
        }
    });

    div.addEventListener("touchmove", cancelPressTimer, { passive: true });

    // Mouse events for desktop
    div.addEventListener("mousedown", (e) => {
        if (e.button !== 0) return; // Only primary click
        startPressTimer(e);
    });

    div.addEventListener("mouseup", (e) => {
        cancelPressTimer();
        if (isLongPressExecuted) return;

        // Desktop native e.detail handles click count
        if (e.detail === 3) {
            handleTripleTap();
        }
    });

    div.addEventListener("mouseleave", cancelPressTimer);
}

function renderChat(isNewMessageAdded = false) {
    if (!chatBox) return;
    chatBox.innerHTML = "";
    
    const currentMessages = sessions[activeSessionId] || [];
    const displayMessages = currentMessages.filter(m => m.role !== "system");

    if (displayMessages.length === 0) {
        chatBox.innerHTML = `
            <div class="welcome-screen">
                <img src="https://raw.githubusercontent.com/hothiptv/AlChat/refs/heads/main/AlChat.png" class="welcome-logo" alt="ModelAsi Logo">
                <div class="welcome-title">ModelAsi</div>
                <div class="small text-secondary mt-1">v0.5.3 (AI Engine)</div>
            </div>
        `;
        return;
    }

    currentMessages.forEach((msg, idx) => {
        if (msg.role === "system") return;

        const div = document.createElement("div");
        div.className = `message ${msg.role === "user" ? "user-msg" : "ai-msg"}`;

        renderFormattedMessageContent(div, msg.content, msg.role === "assistant", msg);
        attachMessageGestureListeners(div, msg, idx);

        chatBox.appendChild(div);
    });

    chatBox.scrollTop = chatBox.scrollHeight;
}

function showThinkingBubble() {
    const activeModel = getActiveModelObj();
    const thinkingDiv = document.createElement("div");
    thinkingDiv.id = "thinkingBubble";
    thinkingDiv.className = "thinking-bubble";
    thinkingDiv.innerHTML = `
        <div class="spinner-ring"></div>
        <span class="fw-semibold">ModelAsi (${escapeHtml(activeModel.name)}) is thinking...</span>
    `;
    chatBox.appendChild(thinkingDiv);
    chatBox.scrollTop = chatBox.scrollHeight;
}

function removeThinkingBubble() {
    const bubble = document.getElementById("thinkingBubble");
    if (bubble) bubble.remove();
}

async function animateTextStreaming(fullText) {
    const div = document.createElement("div");
    div.className = "message ai-msg";
    chatBox.appendChild(div);

    const msgIndex = (sessions[activeSessionId] || []).length - 1;
    const msgObj = sessions[activeSessionId][msgIndex] || { role: "assistant", content: fullText };

    let currentLength = 0;
    const totalLength = fullText.length;
    const chunkSize = Math.max(3, Math.floor(totalLength / 50));

    return new Promise((resolve) => {
        const interval = setInterval(() => {
            currentLength += chunkSize;
            if (currentLength >= totalLength) {
                currentLength = totalLength;
                clearInterval(interval);
                renderFormattedMessageContent(div, fullText, true);
                attachMessageGestureListeners(div, msgObj, msgIndex);
                chatBox.scrollTop = chatBox.scrollHeight;
                resolve();
            } else {
                renderFormattedMessageContent(div, fullText.substring(0, currentLength), true);
                chatBox.scrollTop = chatBox.scrollHeight;
            }
        }, 20);
    });
}

function switchSession(sId) {
    if (isGenerating) return;
    activeSessionId = sId;
    saveLocalSessions();
    renderSidebar();
    renderChat();
    if (sidebar.classList.contains('show')) toggleSidebar();
}

newChatBtn.addEventListener("click", () => {
    if (isGenerating) return;
    const sessionKeys = Object.keys(sessions);
    if (sessionKeys.length >= 5) {
        alert("Reached maximum limit of 5 chats!");
        return;
    }
    const newId = "session_" + Date.now();
    sessions[newId] = [{ role: "system", content: getFullSystemPrompt() }];
    activeSessionId = newId;
    saveLocalSessions();
    renderSidebar();
    renderChat();
    if (sidebar.classList.contains('show')) toggleSidebar();
});

clearChatBtn.addEventListener("click", () => {
    if (isGenerating) return;
    if (confirm("Clear all messages in this chat?")) {
        sessions[activeSessionId] = [{ role: "system", content: getFullSystemPrompt() }];
        saveLocalSessions();
        renderChat();
    }
});

userSettingsBtn.addEventListener("click", () => {
    customUserPromptInput.value = customUserPrompt;
    if (currentTheme === "light") themeLightRadio.checked = true;
    else if (currentTheme === "system") themeSystemRadio.checked = true;
    else themeDarkRadio.checked = true;
    userSettingsModal.show();
    if (sidebar.classList.contains('show')) toggleSidebar();
});

resetUserPromptBtn.addEventListener("click", () => {
    customUserPromptInput.value = "";
});

saveUserSettingsBtn.addEventListener("click", () => {
    customUserPrompt = customUserPromptInput.value.trim();
    localStorage.setItem("modelasi_custom_user_prompt", customUserPrompt);
    
    if (themeLightRadio.checked) currentTheme = "light";
    else if (themeSystemRadio.checked) currentTheme = "system";
    else currentTheme = "dark";
    
    applyTheme(currentTheme);
    localStorage.setItem("modelasi_theme", currentTheme);

    if (sessions[activeSessionId] && sessions[activeSessionId][0]) {
        sessions[activeSessionId][0].content = getFullSystemPrompt();
    }
    saveLocalSessions();
    userSettingsModal.hide();
});

function renderAdminModelsUI() {
    adminModelsListContainer.innerHTML = "";
    if (dbModelsList.length === 0) {
        adminModelsListContainer.innerHTML = `<div class="text-secondary small italic text-center mb-2">No models available in database.</div>`;
        return;
    }

    dbModelsList.forEach(m => {
        const card = document.createElement("div");
        card.className = "p-3 rounded border border-secondary mb-2";
        card.style.backgroundColor = "var(--card-bg)";

        card.innerHTML = `
            <div class="d-flex justify-content-between align-items-center mb-1">
                <div>
                    <span class="fw-bold text-info" style="font-size: 15px;">${escapeHtml(m.name)}</span>
                </div>
                <div class="d-flex gap-1">
                    <button type="button" class="btn btn-outline-warning btn-sm py-0 px-2" onclick="window.editAdminModel('${m.id}')"><i class="bi bi-pencil"></i> Edit</button>
                    <button type="button" class="btn btn-outline-danger btn-sm py-0 px-2" onclick="window.deleteAdminModel('${m.id}')"><i class="bi bi-trash"></i> Delete</button>
                </div>
            </div>
            ${m.subSystem ? `<div class="small text-light bg-dark p-2 rounded border border-secondary mt-2" style="font-family:monospace; font-size:11px; white-space:pre-wrap;">${escapeHtml(m.subSystem)}</div>` : ''}

window.editAdminModel = function(id) {
    const m = dbModelsList.find(item => item.id === id);
    if (!m) return;
    
    editingModelId.value = m.id;
    newModelDisplayName.value = m.name;
    newModelSubSystem.value = m.subSystem || "";

    document.getElementById("adminModelFormTitle").innerHTML = `<i class="bi bi-pencil-square me-1"></i> Edit AI Model`;
    saveModelBtnText.innerText = "Update Model";
    cancelEditModelBtn.classList.remove("d-none");
};

cancelEditModelBtn.addEventListener("click", resetAdminModelForm);

function resetAdminModelForm() {
    editingModelId.value = "";
    newModelDisplayName.value = "";
    newModelSubSystem.value = "";

    document.getElementById("adminModelFormTitle").innerHTML = `<i class="bi bi-plus-circle me-1"></i> Create New AI Model`;
    saveModelBtnText.innerText = "Create Model";
    cancelEditModelBtn.classList.add("d-none");
}

window.deleteAdminModel = function(id) {
    if (confirm("Are you sure you want to delete this Model?")) {
        dbModelsList = dbModelsList.filter(m => m.id !== id);
        if (selectedModelId === id) {
            selectedModelId = dbModelsList.length > 0 ? dbModelsList[0].id : "";
            localStorage.setItem("modelasi_selected_model_id", selectedModelId);
            updateHeaderModelDisplay();
        }
        renderAdminModelsUI();
    }
};

saveModelBtn.addEventListener("click", () => {
    const name = newModelDisplayName.value.trim();
    const subSystem = newModelSubSystem.value.trim();

    if (!name) {
        alert("Please enter Model Display Name!");
        return;
    }

    const editId = editingModelId.value;
    if (editId) {
        const idx = dbModelsList.findIndex(m => m.id === editId);
        if (idx !== -1) {
            dbModelsList[idx] = { id: editId, name, subSystem };
        }
    } else {
        const newObj = {
            id: "model_" + Date.now(),
            name,
            subSystem
        };
        dbModelsList.push(newObj);
        selectedModelId = newObj.id;
        localStorage.setItem("modelasi_selected_model_id", selectedModelId);
    }

    updateHeaderModelDisplay();
    resetAdminModelForm();
    renderAdminModelsUI();
});

function prepareApiMessagesPayload() {
    const messages = sessions[activeSessionId] || [];
    const latestSystemPrompt = getFullSystemPrompt();

    let updatedPayload = [];
    
    // Attach current full system prompt
    updatedPayload.push({ role: "system", content: latestSystemPrompt });

    messages.forEach(msg => {
        if (msg.role === "system") return;

        let contentStr = msg.content || "";
        if (msg.role === "user" && msg.files && msg.files.length > 0) {
            let filesPrompt = "\n\n[USER ATTACHED DOCUMENTS & FILES]:";
            msg.files.forEach(f => {
                filesPrompt += `\n--- FILE NAME: ${f.name} ---\n${f.content}\n--- END FILE ---`;
            });
            contentStr += filesPrompt;
        }
        updatedPayload.push({ role: msg.role, content: contentStr });
    });

    return updatedPayload;
}

async function triggerAICompletion() {
    isGenerating = true;
    userInput.disabled = true;
    sendBtn.disabled = true;
    
    inputWrapper.classList.add("slide-down");
    showThinkingBubble();

    const targetGroqModelTag = globalModelTag && globalModelTag.trim() ? globalModelTag.trim() : "openai/gpt-oss-120b";

    let attempts = 0;
    const maxAttempts = Math.max(1, groqApiKeys.length);
    let success = false;

    const payloadMessages = prepareApiMessagesPayload();

    while (attempts < maxAttempts && !success) {
        const currentKey = getActiveApiKey();
        if (!currentKey) break;

        try {
            const response = await fetch("https://api.groq.com/openai/v1/chat/completions", {
                method: "POST",
                headers: {
                    "Authorization": `Bearer ${currentKey}`,
                    "Content-Type": "application/json"
                },
                body: JSON.stringify({
                    model: targetGroqModelTag,
                    messages: payloadMessages,
                    temperature: 0.7
                })
            });

            const data = await response.json();

            if (response.status === 429 || (data.error && data.error.code === "rate_limit_exceeded")) {
                currentKeyIndex = (currentKeyIndex + 1) % groqApiKeys.length;
                attempts++;
                continue;
            }

            removeThinkingBubble();

            if (data.choices && data.choices[0]) {
                const aiReply = data.choices[0].message.content;
                sessions[activeSessionId].push({ role: "assistant", content: aiReply });
                saveLocalSessions();
                
                await animateTextStreaming(aiReply);
                success = true;
            } else {
                break;
            }
        } catch (err) {
            currentKeyIndex = (currentKeyIndex + 1) % groqApiKeys.length;
            attempts++;
        }
    }

    if (!success) {
        removeThinkingBubble();
        const errMessage = "System is busy or API rate limit exceeded. Please try again later!";
        sessions[activeSessionId].push({ role: "assistant", content: errMessage });
        saveLocalSessions();
        renderChat(true);
    }

    isGenerating = false;
    userInput.disabled = false;
    sendBtn.disabled = false;
    inputWrapper.classList.remove("slide-down");
    updateSendButtonState();
    userInput.focus();
}

async function regenerateMessageFromIndex(msgIndex) {
    if (isGenerating) return;
    if (!sessions[activeSessionId] || msgIndex < 0) return;

    // Truncate messages up to the previous message
    sessions[activeSessionId] = sessions[activeSessionId].slice(0, msgIndex);
    saveLocalSessions();
    renderChat();

    await triggerAICompletion();
}

async function sendMessage() {
    if (isGenerating) return;
    const text = userInput.value.trim();
    if (!text && attachedFiles.length === 0) return;

    if (text === "admin 3677") {
        userInput.value = "";
        userInput.blur();
        updateSendButtonState();
        
        adminApiKey1Input.value = groqApiKeys[0] || "";
        adminApiKey2Input.value = groqApiKeys[1] || "";
        adminApiKey3Input.value = groqApiKeys[2] || "";
        adminGlobalModelTagInput.value = globalModelTag || "openai/gpt-oss-120b";

        adminSystemPromptInput.value = adminSystemPrompt;
        renderAdminModelsUI();
        adminSaveAlert.innerText = "";
        adminModal.show();
        return;
    }

    if (groqApiKeys.length === 0) {
        alert("No API Key configured!");
        return;
    }

    if (!sessions[activeSessionId]) {
        sessions[activeSessionId] = [{ role: "system", content: getFullSystemPrompt() }];
    }

    sessions[activeSessionId][0].content = getFullSystemPrompt();

    const newUserMsg = { role: "user", content: text };
    if (attachedFiles.length > 0) {
        newUserMsg.files = [...attachedFiles];
    }

    sessions[activeSessionId].push(newUserMsg);
    saveLocalSessions();
    renderChat(true);

    userInput.value = "";
    attachedFiles = [];
    renderAttachedFiles();
    userInput.blur();
    updateSendButtonState();

    await triggerAICompletion();
}

saveAdminConfigBtn.addEventListener("click", async () => {
    const k1 = adminApiKey1Input.value.trim();
    const k2 = adminApiKey2Input.value.trim();
    const k3 = adminApiKey3Input.value.trim();
    const newGlobalTag = adminGlobalModelTagInput.value.trim() || "openai/gpt-oss-120b";

    const newKeys = [k1, k2, k3].filter(k => k.length > 0);
    const newPrompt = adminSystemPromptInput.value.trim();

    if (newKeys.length === 0) {
        alert("Please enter at least 1 Groq API Key!");
        return;
    }

    saveAdminConfigBtn.disabled = true;
    adminSaveAlert.className = "small text-center mt-2 text-warning";
    adminSaveAlert.innerText = "Saving configuration to Cloud...";

    try {
        const docRef = doc(db, "modelasi_settings", "config");
        await setDoc(docRef, {
            apiKeys: newKeys,
            apiKey: newKeys[0],
            globalModelTag: newGlobalTag,
            models: dbModelsList,
            systemPrompt: newPrompt,
            updatedAt: new Date().toISOString()
        }, { merge: true });

        groqApiKeys = newKeys;
        currentKeyIndex = 0;
        globalModelTag = newGlobalTag;
        adminSystemPrompt = newPrompt;

        if (sessions[activeSessionId] && sessions[activeSessionId][0]) {
            sessions[activeSessionId][0].content = getFullSystemPrompt();
        }

        saveLocalSessions();

        adminSaveAlert.className = "small text-center mt-2 text-success";
        adminSaveAlert.innerText = "✓ Configuration saved successfully!";
        setTimeout(() => adminModal.hide(), 1000);
    } catch (err) {
        console.error(err);
        adminSaveAlert.className = "small text-center mt-2 text-danger";
        adminSaveAlert.innerText = "Error saving configuration to Cloud!";
    } finally {
        saveAdminConfigBtn.disabled = false;
    }
});

sendBtn.addEventListener("click", sendMessage);

userInput.addEventListener("keypress", (e) => {
    if (e.key === "Enter") {
        e.preventDefault();
        sendMessage();
    }
});

initApp();
